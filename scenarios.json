      "id": "BW-SAT",
      "name": "Gateway Upload / Download Rate",
      "primary_condition": "Capacity exhaustion",
      "temporal": "Sustained",
      "ground_truth": "Link utilisation and throughput",
      "h4_type": "progressive",
      "host": "Station 192.168.1.11 to gateway 192.168.1.1 (iperf3, local only)",
      "window_s": 180,
      "min_recovery_s": 60,
      "script_status": "needs_review",
      "order": null,
      "launch": "./bw_sat_test.sh <rate_mbps> <minutes> takondwa@192.168.1.11 up",
      "verify": [
        "Station: cat /tmp/bw_sat.log (iperf3 interval lines at the target rate)",
        "Prometheus: rate(node_network_transmit_bytes_total{job=\"openwrt-ap1-node\",device=\"eth0\"}[1m]) * 8 / 1000000"
      ],
      "stop": "./stop_fault.sh bwsat takondwa@192.168.1.11",
      "panel": "Gateway Upload / Download Rate (1 minute average rate)",
      "gt_label": "AP1 eth0 throughput (Mbit/s)",
      "notes": "Local iperf3 from the station to the gateway, so Internet bandwidth plays no part. The panel now uses a 1 minute rate, so it reaches the sent rate within about a minute of onset. Change the 5 in the launch command (Mbit/s) to suit the capacity variables.",
      "runner": {
        "auto": true,
        "launch_cmd": "./bw_sat_test.sh 5 {minutes} takondwa@192.168.1.11 up",
        "stop_cmd": "./stop_fault.sh bwsat takondwa@192.168.1.11",
        "extra": [
          "bwsat_pid",
          "bw_up_mbps",
          "bw_down_mbps"
        ],
        "onset": {
          "probe": "bwsat_pid",
          "op": "eq",
          "mode": "abs",
          "value": 1,
          "consec": 1
        },
        "cleared": {
          "probe": "bwsat_pid",
          "op": "eq",
          "mode": "abs",
          "value": 0,
          "consec": 1
        },
        "gt_probe": "bw_up_mbps",
        "gt_dir": "up",
        "preflight": [
          [
            "pid_dead",
            "bwsat_pid"
          ],
          [
            "ssh_ok",
            "station"
          ]
        ]
      },
      "fault": "Bandwidth saturation"
